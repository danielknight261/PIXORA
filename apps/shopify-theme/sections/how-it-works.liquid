<section class="how-it-works" id="how-it-works">
  <div class="page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="how-it-works__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="how-it-works__intro">{{ section.settings.text }}</p>
    {% endif %}

    <ol class="how-it-works__steps">
      {% for block in section.blocks %}
        <li class="how-it-works__step" {{ block.shopify_attributes }}>
          <div class="how-it-works__marker">
            <span class="how-it-works__number{% if forloop.first %} how-it-works__number--accent{% endif %}" aria-hidden="true">{{ forloop.index }}</span>
            {% unless forloop.last %}
              <span class="how-it-works__connector" aria-hidden="true"></span>
            {% endunless %}
          </div>
          <h3 class="how-it-works__title">{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p class="how-it-works__desc">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.detail != blank %}
            <p class="how-it-works__detail">{{ block.settings.detail }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ol>

    {% if section.settings.footnote != blank %}
      <p class="how-it-works__footnote">{{ section.settings.footnote }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From photo to doorstep"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Three steps. Live mockup before you pay. Printed near you when we can."
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "Typical delivery depends on your country — see the note on each product."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Upload your photo"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Use a clear JPG or PNG from your phone or computer. Higher resolution prints sharper."
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "JPG · PNG"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Upload your photo",
            "text": "Use a clear JPG or PNG from your phone or computer. Higher resolution prints sharper.",
            "detail": "JPG · PNG"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Personalise live",
            "text": "Place and crop on a real product mockup so you see the finish before checkout.",
            "detail": "Live preview"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "We print & ship",
            "text": "Made to order with Gelato — often printed locally, then packed and delivered to your door.",
            "detail": "Print on demand"
          }
        }
      ]
    }
  ]
}
{% endschema %}
