<section class="trust-strip">
  <div class="page-width trust-strip__inner">
    {% for block in section.blocks %}
      <div class="trust-strip__item" {{ block.shopify_attributes }}>
        <span class="trust-strip__dot trust-strip__dot--{{ block.settings.accent | default: 'cyan' }}" aria-hidden="true"></span>
        <div>
          <p class="trust-strip__title">{{ block.settings.title }}</p>
          {% if block.settings.text != blank %}
            <p class="trust-strip__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium print quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Vibrant colour, durable finishes"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Accent",
          "options": [
            { "value": "cyan", "label": "Cyan" },
            { "value": "magenta", "label": "Magenta" },
            { "value": "blue", "label": "Blue" },
            { "value": "mint", "label": "Mint" }
          ],
          "default": "cyan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Premium print quality",
            "text": "Vivid colour & durable finishes",
            "accent": "cyan"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Live product mockups",
            "text": "See your design before you buy",
            "accent": "magenta"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Printed on demand",
            "text": "Made for you, shipped to your door",
            "accent": "mint"
          }
        }
      ]
    }
  ]
}
{% endschema %}
