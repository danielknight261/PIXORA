<section class="trust-strip">
  {%- liquid
    assign live_delivery_used = false
    for block in section.blocks
      assign title_down = block.settings.title | downcase
      if title_down contains 'printed on demand' or title_down contains 'printed on-demand' or title_down contains 'print on demand'
        assign live_delivery_used = true
      endif
    endfor
  -%}
  <div class="page-width trust-strip__inner{% unless live_delivery_used %} trust-strip__inner--plus{% endunless %}">
    {% for block in section.blocks %}
      {%- liquid
        assign title_down = block.settings.title | downcase
        assign is_pod = false
        if title_down contains 'printed on demand' or title_down contains 'printed on-demand' or title_down contains 'print on demand'
          assign is_pod = true
        endif
      -%}
      <div class="trust-strip__item" {{ block.shopify_attributes }}>
        <span class="trust-strip__dot trust-strip__dot--{{ block.settings.accent | default: 'cyan' }}" aria-hidden="true"></span>
        <div>
          <p class="trust-strip__title">{% if is_pod %}{{ 'delivery.title' | t }}{% else %}{{ block.settings.title }}{% endif %}</p>
          {% if is_pod %}
            <p class="trust-strip__text">{% render 'local-print-promise', tag: 'span', class: 'local-print-promise' %}</p>
          {% elsif block.settings.text != blank %}
            <p class="trust-strip__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% unless live_delivery_used %}
      <div class="trust-strip__item">
        <span class="trust-strip__dot trust-strip__dot--mint" aria-hidden="true"></span>
        <div>
          <p class="trust-strip__title">{{ 'delivery.title' | t }}</p>
          <p class="trust-strip__text">{% render 'local-print-promise', tag: 'span', class: 'local-print-promise' %}</p>
        </div>
      </div>
    {% endunless %}
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium print quality"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Vibrant colour, durable finishes"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Accent",
          "options": [
            { "value": "cyan", "label": "Cyan" },
            { "value": "magenta", "label": "Magenta" },
            { "value": "blue", "label": "Blue" },
            { "value": "mint", "label": "Mint" }
          ],
          "default": "cyan"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Premium print quality",
            "text": "Vivid colour & durable finishes",
            "accent": "cyan"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Live product mockups",
            "text": "See your design before you buy",
            "accent": "magenta"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Printed on demand",
            "text": "Made for you, shipped to your door",
            "accent": "mint"
          }
        }
      ]
    }
  ]
}
{% endschema %}
