<section class="download-file page-width">
  <h1 class="download-file__title">{{ section.settings.heading }}</h1>
  {% if section.settings.text != blank %}
    <p class="download-file__text">{{ section.settings.text }}</p>
  {% endif %}
  <a
    class="button button--primary"
    href="{{ 'canvas-slim-thick-variants.csv' | asset_url }}"
    download="canvas-slim-thick-variants.csv"
  >
    {{ section.settings.button_label }}
  </a>
  <p class="download-file__meta muted">
    File: canvas-slim-thick-variants.csv · Slim + Thick canvas variants for Gelato
  </p>
</section>

{% schema %}
{
  "name": "Download file",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Canvas variants CSV"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Download the Pixora canvas slim + thick variant list (Product UIDs) for building your Gelato template."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Download CSV"
    }
  ]
}
{% endschema %}
