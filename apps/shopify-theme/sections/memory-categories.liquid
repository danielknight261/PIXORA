<section class="home-editorial">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="home-editorial__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="home-editorial__intro">{{ section.settings.text }}</p>
    {% endif %}
    <div class="memory-cats">
      {% for block in section.blocks %}
        <a class="memory-cat" href="{{ block.settings.link | default: '/collections/wall-art' }}" {{ block.shopify_attributes }}>
          <div class="memory-cat__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 900px) 30vw, 90vw', alt: block.settings.title
              }}
            {% elsif block.settings.fallback_asset != blank %}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="1600" height="2000" loading="lazy">
            {% endif %}
          </div>
          <div class="memory-cat__copy">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Turn memories into",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Turn memories into…" },
    { "type": "textarea", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename" }
      ]
    }
  ],
  "presets": [{ "name": "Turn memories into" }]
}
{% endschema %}
