<section class="hero hero--home">
  <div class="page-width hero__inner">
    <div class="hero__copy">
      <p class="hero__brand">
        <span class="brand-wordmark__snapp">Snapp</span>
        <span class="brand-wordmark__daddy">Daddy</span>
      </p>
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <p class="hero__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}
        <div class="hero__actions">
          {% if section.settings.button_label != blank %}
            <a class="button button--primary" href="{{ section.settings.button_link | default: '/collections/wall-art' }}">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
          {% if section.settings.button_label_2 != blank %}
            <a class="button button--secondary" href="{{ section.settings.button_link_2 | default: '/collections/home-gifts' }}">
              {{ section.settings.button_label_2 }}
            </a>
          {% endif %}
        </div>
      {% endif %}
      {% render 'local-print-promise', class: 'hero__delivery local-print-promise' %}
    </div>
    <div class="hero__media" aria-hidden="true">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag: class: 'hero__media-img', loading: 'eager', widths: '800,1200,1600', sizes: '(min-width: 900px) 48vw, 100vw'
        }}
      {% else %}
        {% render 'category-thumb', handle: 'framed-canvas', alt: '', class: 'hero__media-img', width: 1200 %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Optional. Defaults to a framed canvas product photo."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Print your favourites"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Preview your photo on the product, then we print and ship."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Shop wall art"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button",
      "default": "Shop gifts"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
