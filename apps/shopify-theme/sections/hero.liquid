<section class="hero">
  <div class="page-width hero__inner">
    <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <p class="hero__text">{{ section.settings.text }}</p>
    {% if section.settings.button_label != blank %}
      <a class="button button--primary" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Photo personalization"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn Moments Into Keepsakes"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Upload your photos. Preview on real Gelato products. Canvas, mugs, and more — printed and shipped for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop products"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
