<section class="hero hero--home">
  <div class="page-width hero__inner">
    <div class="hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <p class="hero__text">{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}
        <div class="hero__actions">
          {% if section.settings.button_label != blank %}
            <a class="button button--primary" href="{{ section.settings.button_link | default: '/collections/wall-art' }}">
              {{ section.settings.button_label }}
            </a>
          {% endif %}
          {% if section.settings.button_label_2 != blank %}
            <a class="button button--secondary" href="{{ section.settings.button_link_2 | default: '/collections/home-gifts' }}">
              {{ section.settings.button_label_2 }}
            </a>
          {% endif %}
        </div>
      {% endif %}
      {% render 'local-print-promise', class: 'hero__delivery local-print-promise' %}
    </div>
    <div class="hero__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'hero__media-img',
            loading: 'eager',
            widths: '800,1200,1800',
            sizes: '(min-width: 900px) 52vw, 100vw',
            alt: section.settings.heading
        }}
      {% else %}
        <img
          src="{{ 'classic-framed-story-room.webp' | asset_url }}"
          class="hero__media-img"
          alt=""
          width="1679"
          height="2100"
        >
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Landscape lifestyle shot. Falls back to a framed print in a room."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your memories, made to keep."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Turn your favourite photos into beautiful wall art, gifts and everyday things."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Create something personal →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button",
      "default": "Explore gifts"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
