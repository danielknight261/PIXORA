<section class="home-editorial home-editorial--center">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="home-editorial__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="home-editorial__intro">{{ section.settings.text }}</p>
    {% endif %}
    <div class="occasion-grid">
      {% for block in section.blocks %}
        <a class="occasion-tile" href="{{ block.settings.link | default: '/collections/wall-art' }}" {{ block.shopify_attributes }}>
          <span>{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by occasion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by occasion" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Start with why you’re buying — we’ll help with the rest." }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Shop by occasion" }]
}
{% endschema %}
