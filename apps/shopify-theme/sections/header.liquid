{%- comment -%}
  Store header — category mega menus for wall art, gifts, paper prints, occasions.
{%- endcomment -%}
{%- liquid
  capture header_canvas_from
    render 'from-price', handle: 'canvas-20x20-cm-8x8'
  endcapture
  capture header_posters_from
    render 'from-price', handle: 'posters'
  endcapture
  capture header_framed_canvas_from
    render 'from-price', handle: 'framed-canvas'
  endcapture
  capture header_framed_from
    render 'from-price', handle: 'framed-prints'
  endcapture
  capture header_aluminum_from
    render 'from-price', handle: 'aluminum-prints'
  endcapture
  capture header_acrylic_from
    render 'from-price', handle: 'acrylic-print'
  endcapture
  capture header_foam_from
    render 'from-price', handle: 'foam-prints'
  endcapture
  capture header_wood_from
    render 'from-price', handle: 'wood-prints'
  endcapture
  capture header_hangers_from
    render 'from-price', handle: 'premium-matte-paper-poster-with-hanger'
  endcapture
  capture header_mugs_from
    render 'from-price', handle: 'mugs'
  endcapture
  capture header_bottle_from
    render 'from-price', handle: 'white-17oz-stainless-steel-water-bottle'
  endcapture
  capture header_cases_from
    render 'from-price', handle: 'phone-cases'
  endcapture
  capture header_totes_from
    render 'from-price', handle: 'tote-bags'
  endcapture
  capture header_stickers_from
    render 'from-price', handle: 'stickers'
  endcapture
  capture header_tattoos_from
    render 'from-price', handle: 'tattoos'
  endcapture
  capture header_magnets_from
    render 'from-price', handle: 'magnets'
  endcapture
  capture header_tiles_from
    render 'from-price', handle: 'photo-tiles'
  endcapture
  capture header_cushions_from
    render 'from-price', handle: 'cushions'
  endcapture
  capture header_prisms_from
    render 'from-price', handle: 'acrylic-prisms'
  endcapture
  capture header_jigsaws_from
    render 'from-price', handle: 'jigsaws'
  endcapture
  capture header_towels_from
    render 'from-price', handle: 'towels'
  endcapture
  assign header_canvas_from = header_canvas_from | strip
  assign header_posters_from = header_posters_from | strip
  assign header_framed_canvas_from = header_framed_canvas_from | strip
  assign header_framed_from = header_framed_from | strip
  assign header_aluminum_from = header_aluminum_from | strip
  assign header_acrylic_from = header_acrylic_from | strip
  assign header_foam_from = header_foam_from | strip
  assign header_wood_from = header_wood_from | strip
  assign header_hangers_from = header_hangers_from | strip
  assign header_mugs_from = header_mugs_from | strip
  assign header_bottle_from = header_bottle_from | strip
  assign header_cases_from = header_cases_from | strip
  assign header_totes_from = header_totes_from | strip
  assign header_stickers_from = header_stickers_from | strip
  assign header_tattoos_from = header_tattoos_from | strip
  assign header_magnets_from = header_magnets_from | strip
  assign header_tiles_from = header_tiles_from | strip
  assign header_cushions_from = header_cushions_from | strip
  assign header_prisms_from = header_prisms_from | strip
  assign header_jigsaws_from = header_jigsaws_from | strip
  assign header_towels_from = header_towels_from | strip
-%}
<header class="site-header">
  <div class="site-header__utility">
    <div class="page-width site-header__utility-inner">
      <a class="site-header__logo" href="{{ routes.root_url }}">
        {% render 'brand-logo', logo_class: 'site-header__logo-img' %}
        <span class="site-header__brand">{{ settings.brand_name | default: 'Snapp Daddy' }}</span>
      </a>

      <div class="site-header__actions">
        {% render 'localization-form', unique: 'header' %}
        <a class="site-header__util-link" href="{{ settings.help_link | default: '/pages/contact' }}">
          <span class="site-header__util-label">{{ 'general.help' | t }}</span>
        </a>
        <a class="site-header__util-link" href="{{ routes.account_url }}">
          <span class="site-header__util-label">
            {% if customer %}{{ 'general.your_orders' | t }}{% else %}{{ 'general.sign_in' | t }}{% endif %}
          </span>
        </a>
        <a class="site-header__basket" href="{{ routes.cart_url }}">
          <svg class="site-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="site-header__util-label">{{ 'general.basket' | t }}</span>
          {% if cart.item_count > 0 %}
            <span class="site-header__badge">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  <div class="site-header__categories site-header__categories--desktop">
    <nav class="page-width site-header__categories-inner" aria-label="{{ 'header.shop_categories' | t }}">
      <div class="site-header__cat">
        <a class="site-header__cat-link site-header__cat-link--wall" href="{{ collections['wall-art'].url | default: '/collections/wall-art' }}">
          {{ 'header.wall_art' | t }}
          <svg class="site-header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="site-header__panel site-header__panel--wide" role="menu">
          <p class="site-header__panel-kicker">{{ 'header.print_for_walls' | t }}</p>
          <div class="site-header__panel-grid site-header__panel-grid--3">
            <a class="site-header__tile" href="/products/canvas-20x20-cm-8x8">
              <span class="site-header__swatch site-header__swatch--blue" aria-hidden="true">{% render 'category-thumb', handle: 'canvas-20x20-cm-8x8', alt: 'Canvas prints', class: 'site-header__thumb', width: 160 %}</span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">{{ 'header.canvas' | t }}</span>
                <span class="site-header__tile-desc">{% if header_canvas_from != blank %}{{ header_canvas_from }}{% else %}{{ 'header.fallback_canvas' | t }}{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/posters">
              <span class="site-header__swatch site-header__swatch--rose" aria-hidden="true">{% render 'category-thumb', handle: 'posters', alt: 'Posters', class: 'site-header__thumb', width: 160 %}</span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">{{ 'header.posters' | t }}</span>
                <span class="site-header__tile-desc">{% if header_posters_from != blank %}{{ header_posters_from }} · 3 finishes{% else %}{{ 'header.fallback_posters' | t }}{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/framed-canvas">
              <span class="site-header__swatch site-header__swatch--cyan" aria-hidden="true">{% render 'category-thumb', handle: 'framed-canvas', alt: 'Framed canvas', class: 'site-header__thumb', width: 160 %}</span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">{{ 'header.framed_canvas' | t }}</span>
                <span class="site-header__tile-desc">{% if header_framed_canvas_from != blank %}{{ header_framed_canvas_from }} · tray frame{% else %}{{ 'header.fallback_framed_canvas' | t }}{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/framed-prints">
