{%- comment -%}
  Pixora studio header — category mega menus for wall art, gifts, photo printing, occasions.
{%- endcomment -%}
{%- liquid
  capture header_canvas_from
    render 'from-price', handle: 'canvas-20x20-cm-8x8'
  endcapture
  capture header_posters_from
    render 'from-price', handle: 'posters'
  endcapture
  capture header_framed_canvas_from
    render 'from-price', handle: 'framed-canvas'
  endcapture
  capture header_framed_from
    render 'from-price', handle: 'framed-prints'
  endcapture
  capture header_aluminum_from
    render 'from-price', handle: 'aluminum-prints'
  endcapture
  capture header_acrylic_from
    render 'from-price', handle: 'acrylic-print'
  endcapture
  capture header_foam_from
    render 'from-price', handle: 'foam-prints'
  endcapture
  capture header_wood_from
    render 'from-price', handle: 'wood-prints'
  endcapture
  capture header_hangers_from
    render 'from-price', handle: 'premium-matte-paper-poster-with-hanger'
  endcapture
  capture header_mugs_from
    render 'from-price', handle: 'mugs'
  endcapture
  capture header_bottle_from
    render 'from-price', handle: 'white-17oz-stainless-steel-water-bottle'
  endcapture
  assign header_canvas_from = header_canvas_from | strip
  assign header_posters_from = header_posters_from | strip
  assign header_framed_canvas_from = header_framed_canvas_from | strip
  assign header_framed_from = header_framed_from | strip
  assign header_aluminum_from = header_aluminum_from | strip
  assign header_acrylic_from = header_acrylic_from | strip
  assign header_foam_from = header_foam_from | strip
  assign header_wood_from = header_wood_from | strip
  assign header_hangers_from = header_hangers_from | strip
  assign header_mugs_from = header_mugs_from | strip
  assign header_bottle_from = header_bottle_from | strip
-%}
<header class="site-header">
  <div class="site-header__utility">
    <div class="page-width site-header__utility-inner">
      <a class="site-header__logo" href="{{ routes.root_url }}">
        <span class="site-header__mark" aria-hidden="true"></span>
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 200 | image_tag: alt: settings.brand_name, class: 'site-header__logo-img' }}
        {% else %}
          <span class="site-header__brand">{{ settings.brand_name | default: 'Pixora' }}</span>
        {% endif %}
      </a>

      <div class="site-header__actions">
        <a class="site-header__util-link" href="{{ settings.help_link | default: '/pages/contact' }}">
          <span class="site-header__util-label">Help</span>
        </a>
        <a class="site-header__util-link" href="{{ routes.account_url }}">
          <span class="site-header__util-label">
            {% if customer %}Account{% else %}Sign in{% endif %}
          </span>
        </a>
        <a class="site-header__basket" href="{{ routes.cart_url }}">
          <svg class="site-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="site-header__util-label">Basket</span>
          {% if cart.item_count > 0 %}
            <span class="site-header__badge">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  <div class="site-header__categories site-header__categories--desktop">
    <nav class="page-width site-header__categories-inner" aria-label="Shop categories">
      <div class="site-header__cat">
        <a class="site-header__cat-link site-header__cat-link--wall" href="/collections/wall-art">
          Wall art
          <svg class="site-header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="site-header__panel site-header__panel--wide" role="menu">
          <p class="site-header__panel-kicker">Print for your walls</p>
          <div class="site-header__panel-grid site-header__panel-grid--3">
            <a class="site-header__tile" href="/products/canvas-20x20-cm-8x8">
              <span class="site-header__swatch site-header__swatch--blue" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Canvas prints</span>
                <span class="site-header__tile-desc">{% if header_canvas_from != blank %}{{ header_canvas_from }}{% else %}Sizes, wraps &amp; personalize{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/posters">
              <span class="site-header__swatch site-header__swatch--rose" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Posters</span>
                <span class="site-header__tile-desc">{% if header_posters_from != blank %}{{ header_posters_from }} · 3 finishes{% else %}Matte, fine art &amp; semi-glossy{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/framed-canvas">
              <span class="site-header__swatch site-header__swatch--cyan" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Framed canvas</span>
                <span class="site-header__tile-desc">{% if header_framed_canvas_from != blank %}{{ header_framed_canvas_from }} · tray frame{% else %}Tray frame · 3 colours{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/framed-prints">
              <span class="site-header__swatch site-header__swatch--mint" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Framed prints</span>
                <span class="site-header__tile-desc">{% if header_framed_from != blank %}{{ header_framed_from }} · wood &amp; metal{% else %}Wood &amp; metal frames{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/aluminum-prints">
              <span class="site-header__swatch site-header__swatch--slate" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Metal / aluminium</span>
                <span class="site-header__tile-desc">{% if header_aluminum_from != blank %}{{ header_aluminum_from }}{% else %}Smooth &amp; brushed{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/products/acrylic-print">
              <span class="site-header__swatch site-header__swatch--cyan" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Acrylic prints</span>
                <span class="site-header__tile-desc">{% if header_acrylic_from != blank %}{{ header_acrylic_from }}{% else %}Glossy, vivid colour{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/products/premium-matte-paper-poster-with-hanger">
              <span class="site-header__swatch site-header__swatch--magenta" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Posters with hangers</span>
                <span class="site-header__tile-desc">{% if header_hangers_from != blank %}{{ header_hangers_from }}{% else %}Matte · hanger colours{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/foam-prints">
              <span class="site-header__swatch site-header__swatch--blue" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Foam prints</span>
                <span class="site-header__tile-desc">{% if header_foam_from != blank %}{{ header_foam_from }}{% else %}Portrait · landscape · square{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/products/wood-prints">
              <span class="site-header__swatch site-header__swatch--mint" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Wood prints</span>
                <span class="site-header__tile-desc">{% if header_wood_from != blank %}{{ header_wood_from }}{% else %}Natural grain · thickness{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile site-header__tile--all" href="/collections/wall-art">
              <span class="site-header__swatch site-header__swatch--teal" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">All wall art</span>
                <span class="site-header__tile-desc">Browse every wall product</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="site-header__cat">
        <a class="site-header__cat-link site-header__cat-link--gifts" href="/collections/home-gifts">
          Home &amp; gifts
          <svg class="site-header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="site-header__panel site-header__panel--wide" role="menu">
          <p class="site-header__panel-kicker">Gifts they’ll keep</p>
          <div class="site-header__panel-grid site-header__panel-grid--3">
            <a class="site-header__tile" href="/collections/mugs">
              <span class="site-header__swatch site-header__swatch--magenta" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Mugs</span>
                <span class="site-header__tile-desc">{% if header_mugs_from != blank %}{{ header_mugs_from }}{% else %}Ceramic · personalize{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/products/white-17oz-stainless-steel-water-bottle">
              <span class="site-header__swatch site-header__swatch--slate" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Water bottles</span>
                <span class="site-header__tile-desc">{% if header_bottle_from != blank %}{{ header_bottle_from }}{% else %}Stainless steel{% endif %}</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/cushions">
              <span class="site-header__swatch site-header__swatch--rose" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Cushions</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/photo-blocks">
              <span class="site-header__swatch site-header__swatch--cyan" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Photo blocks</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/magnets">
              <span class="site-header__swatch site-header__swatch--blue" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Magnets</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/jigsaws">
              <span class="site-header__swatch site-header__swatch--mint" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Jigsaws</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile site-header__tile--all" href="/collections/home-gifts">
              <span class="site-header__swatch site-header__swatch--teal" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">All home &amp; gifts</span>
                <span class="site-header__tile-desc">Browse gift products</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="site-header__cat">
        <a class="site-header__cat-link site-header__cat-link--prints" href="/collections/photo-printing">
          Photo printing
          <svg class="site-header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="site-header__panel site-header__panel--narrow" role="menu">
          <p class="site-header__panel-kicker">Print your photos</p>
          <div class="site-header__panel-list">
            <a class="site-header__tile" href="/collections/photo-prints">
              <span class="site-header__swatch site-header__swatch--blue" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Photo prints</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/photo-enlargements">
              <span class="site-header__swatch site-header__swatch--cyan" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Photo enlargements</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/posters">
              <span class="site-header__swatch site-header__swatch--rose" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Posters</span>
                <span class="site-header__tile-desc">{% if header_posters_from != blank %}{{ header_posters_from }}{% else %}Live now{% endif %}</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="site-header__cat">
        <a class="site-header__cat-link site-header__cat-link--cards" href="/collections/occasions">
          Occasions
          <svg class="site-header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="site-header__panel site-header__panel--narrow" role="menu">
          <p class="site-header__panel-kicker">Celebrate with photos</p>
          <div class="site-header__panel-list">
            <a class="site-header__tile" href="/collections/cards">
              <span class="site-header__swatch site-header__swatch--magenta" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Cards</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/calendars">
              <span class="site-header__swatch site-header__swatch--mint" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Calendars</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
            <a class="site-header__tile" href="/collections/photo-books">
              <span class="site-header__swatch site-header__swatch--slate" aria-hidden="true"></span>
              <span class="site-header__tile-copy">
                <span class="site-header__tile-title">Photo books</span>
                <span class="site-header__tile-desc">Coming soon</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <div class="site-header__categories site-header__categories--mobile">
    <nav class="page-width site-header__categories-inner" aria-label="Shop categories">
      <a class="site-header__chip site-header__chip--blue" href="/collections/wall-art">Wall art</a>
      <a class="site-header__chip site-header__chip--rose" href="/collections/posters">Posters</a>
      <a class="site-header__chip site-header__chip--magenta" href="/collections/home-gifts">Gifts</a>
      <a class="site-header__chip site-header__chip--cyan" href="/collections/photo-printing">Photo prints</a>
      <a class="site-header__chip site-header__chip--teal" href="/collections/occasions">Occasions</a>
    </nav>
  </div>

  <div class="site-header__spectrum" aria-hidden="true"></div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
