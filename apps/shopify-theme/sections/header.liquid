            <a class="site-header__tile site-header__tile--all" href="/collections/wall-art">
              <span class="site-header__swatch site-header__swatch--teal" aria-hidden="true">{% render 'category-thumb', handle: 'wall-art', alt: 'All wall art', class: 'site-header__thumb', width: 160 %}</span>
