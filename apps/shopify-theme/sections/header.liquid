                <span class="site-header__tile-desc">{{ 'general.coming_soon' | t }}</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <div class="site-header__categories site-header__categories--mobile">
    <nav class="page-width site-header__categories-inner" aria-label="{{ 'header.shop_categories' | t }}">
      <a class="site-header__chip site-header__chip--blue" href="{{ collections['wall-art'].url | default: '/collections/wall-art' }}">{{ 'header.wall_art' | t }}</a>
      <a class="site-header__chip site-header__chip--rose" href="{{ collections['posters'].url | default: '/collections/posters' }}">{{ 'header.posters' | t }}</a>
      <a class="site-header__chip site-header__chip--magenta" href="{{ collections['home-gifts'].url | default: '/collections/home-gifts' }}">{{ 'header.gifts' | t }}</a>
      <a class="site-header__chip site-header__chip--teal" href="{{ collections['occasions'].url | default: '/collections/occasions' }}">{{ 'header.occasions' | t }}</a>
    </nav>
  </div>

</header>

