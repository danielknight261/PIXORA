                <span class="site-header__tile-title">{{ 'header.all_wall_art' | t }}</span>
                <span class="site-header__tile-desc">{{ 'header.browse_wall' | t }}</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="site-header__cat">
        <a class="site-header__cat-link site-header__cat-link--gifts" href="{{ collections['home-gifts'].url | default: '/collections/home-gifts' }}">
