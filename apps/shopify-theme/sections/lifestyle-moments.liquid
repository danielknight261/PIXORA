<section class="home-editorial home-editorial--sage home-editorial--center">
  <div class="page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="home-editorial__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="home-editorial__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="home-editorial__intro">{{ section.settings.text }}</p>
    {% endif %}

    <div class="moments">
      {% for block in section.blocks %}
        <a
          class="moment"
          href="{{ block.settings.link | default: '/collections/wall-art' }}"
          {{ block.shopify_attributes }}
        >
          <div class="moment__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag: loading: 'lazy', widths: '600,1000,1400', sizes: '(min-width: 900px) 45vw, 90vw', alt: block.settings.title
              }}
            {% elsif block.settings.fallback_asset != blank %}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="" width="1600" height="2000" loading="lazy">
            {% endif %}
          </div>
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle moments",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why we make these" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The moments worth keeping." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Your favourite moments deserve more than a camera roll." }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename" }
      ]
    }
  ],
  "presets": [{ "name": "Lifestyle moments" }]
}
{% endschema %}
