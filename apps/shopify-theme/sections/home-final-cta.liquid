<section class="home-final-cta">
  <div class="page-width home-final-cta__inner">
    <div class="home-final-cta__copy">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button button--primary" href="{{ section.settings.button_link | default: '/collections/wall-art' }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
    <div class="home-final-cta__media" aria-hidden="true">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'lazy', class: 'home-final-cta__img', widths: '700,1100,1400', sizes: '(min-width: 900px) 40vw, 100vw', alt: ''
        }}
      {% else %}
        <img
          src="{{ section.settings.fallback_asset | default: 'premium-framed-story-room.webp' | asset_url }}"
          class="home-final-cta__img"
          alt=""
          width="1680"
          height="2100"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your favourite moments deserve more than a camera roll." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Upload a photo, see it on the product, and we’ll print it to keep." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Create something personal →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset filename", "default": "premium-framed-story-room.webp" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
