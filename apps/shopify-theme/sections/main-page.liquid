<section class="main-page">
  <header class="page-hero">
    <div class="page-width page-hero__inner">
      <p class="page-hero__eyebrow">{{ settings.brand_name | default: shop.name }}</p>
      <h1 class="page-hero__title">{{ page.title }}</h1>
    </div>
  </header>
  <div class="page-width main-page__body">
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "templates": ["page"]
}
{% endschema %}
