<section class="product-blocks page-width">
  {% if section.settings.heading != blank %}
    <h2 class="product-blocks__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.text != blank %}
    <p class="product-blocks__intro">{{ section.settings.text }}</p>
  {% endif %}

  <div class="product-blocks__grid">
    {% for block in section.blocks %}
      {% if block.settings.coming_soon %}
        {% continue %}
      {% endif %}
      {% liquid
        assign card_href = block.settings.link | default: routes.collections_url
        assign live_from = blank
        assign thumb_handle = blank
        assign link_path = card_href | split: '?' | first
        if link_path contains '/products/'
          assign product_handle = link_path | split: '/products/' | last | split: '/' | first
          assign thumb_handle = product_handle
          capture live_from
            render 'from-price', handle: product_handle
          endcapture
        elsif link_path contains '/collections/'
          assign collection_handle = link_path | split: '/collections/' | last | split: '/' | first
          assign thumb_handle = collection_handle
          if collection_handle == 'canvas-prints' or collection_handle == 'canvas'
            assign thumb_handle = 'canvas-20x20-cm-8x8'
            capture live_from
              render 'from-price', handle: 'canvas-20x20-cm-8x8'
            endcapture
          else
            capture live_from
              render 'from-price', handle: collection_handle
            endcapture
          endif
        endif
        assign live_from = live_from | strip
        assign price_text = blank
        if live_from != blank
          assign price_text = live_from
        elsif block.settings.price_label != blank and block.settings.price_label != 'Coming soon'
          assign price_text = block.settings.price_label
        endif
        capture thumb_html
          if thumb_handle != blank
            render 'category-thumb', handle: thumb_handle, alt: block.settings.title, class: 'product-block__img', width: 800
          endif
        endcapture
        assign thumb_html = thumb_html | strip
      %}
      <a
        class="product-block"
        href="{{ card_href }}"
        {{ block.shopify_attributes }}
      >
        <div
          class="product-block__media{% if thumb_html != blank or block.settings.image != blank %} product-block__media--photo{% endif %}"
          {% if block.settings.image != blank %}
            style="background-image: url({{ block.settings.image | image_url: width: 800 }})"
          {% endif %}
        >
          {% if block.settings.image == blank and thumb_html != blank %}
            {{ thumb_html }}
          {% elsif block.settings.image == blank %}
            <span class="product-block__glyph" aria-hidden="true">
              {{ block.settings.title | slice: 0 | upcase }}
            </span>
          {% endif %}
        </div>
        <div class="product-block__info">
          <h2 class="product-block__title">{{ block.settings.title }}</h2>
          {% if price_text != blank %}
            <p class="product-block__price">{{ price_text }}</p>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>

  {% if section.settings.footer_heading != blank or section.settings.footer_text != blank %}
    <div class="product-blocks__footer">
      {% if section.settings.footer_heading != blank %}
        <h2 class="product-blocks__footer-heading">{{ section.settings.footer_heading }}</h2>
      {% endif %}
      {% if section.settings.footer_text != blank %}
        <p class="product-blocks__footer-text">{{ section.settings.footer_text }}</p>
      {% endif %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product blocks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Photo products"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "Print life's best moments with Snapp Daddy. From canvas wall art to personalised mugs, turn your favourite snaps into unique keepsakes — perfect for gifting or keeping for yourself."
    },
    {
      "type": "text",
      "id": "footer_heading",
      "label": "Footer heading",
      "default": "Give your photos the treatment they deserve"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Upload your photos, personalise on the product, and we'll print and ship high-quality keepsakes to your door. Start with canvas or mugs — more products coming soon."
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Canvas prints"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price label",
          "default": "From £14.99"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Placeholder accent",
          "options": [
            { "value": "blue", "label": "Electric blue" },
            { "value": "magenta", "label": "Magenta" },
            { "value": "cyan", "label": "Cyan" },
            { "value": "mint", "label": "Mint" },
            { "value": "rose", "label": "Rose" },
            { "value": "slate", "label": "Slate" },
            { "value": "emerald", "label": "Mint (alias)" }
          ],
          "default": "blue"
        },
        {
          "type": "checkbox",
          "id": "coming_soon",
          "label": "Coming soon",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product blocks",
      "blocks": [
        {
          "type": "product_block",
          "settings": {
            "title": "Canvas prints",
            "price_label": "From £14.99",
            "accent": "blue"
          }
        },
        {
          "type": "product_block",
          "settings": {
            "title": "Personalised mugs",
            "price_label": "From £11.99",
            "accent": "magenta"
          }
        },
        {
          "type": "product_block",
          "settings": {
            "title": "Framed prints",
            "price_label": "From £20.64",
            "link": "/collections/framed-prints",
            "accent": "mint",
            "coming_soon": false
          }
        },
        {
          "type": "product_block",
          "settings": {
            "title": "Greeting cards",
            "price_label": "Coming soon",
            "link": "/collections/cards",
            "accent": "rose",
            "coming_soon": true
          }
        },
        {
          "type": "product_block",
          "settings": {
            "title": "Posters",
            "price_label": "From £6.18",
            "link": "/collections/posters",
            "accent": "rose",
            "coming_soon": false
          }
        },
        {
          "type": "product_block",
          "settings": {
            "title": "Phone cases",
            "price_label": "Coming soon",
            "link": "/collections/phone-cases",
            "accent": "cyan",
            "coming_soon": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
