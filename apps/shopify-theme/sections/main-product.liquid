{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign size_option_index = nil
  assign orientation_option_index = nil
  assign thickness_option_index = nil
  assign frame_option_index = nil
  assign combined_option_index = nil
  assign assembly_option_index = nil
  assign hanger_option_index = nil
  assign color_option_index = nil
  for option in product.options_with_values
    assign opt_down = option.name | downcase
    if opt_down contains 'orientation' and opt_down contains 'size'
      assign combined_option_index = forloop.index0
    elsif opt_down == 'size' or opt_down contains 'size'
      assign size_option_index = forloop.index0
    elsif opt_down == 'orientation' or opt_down contains 'orientation'
      assign orientation_option_index = forloop.index0
    endif
    if opt_down == 'thickness' or opt_down contains 'thickness' or opt_down contains 'depth' or opt_down contains 'wrap'
      assign thickness_option_index = forloop.index0
    endif
    if opt_down == 'frame' or opt_down == 'frame colour' or opt_down == 'frame color'
      assign frame_option_index = forloop.index0
    endif
    if opt_down == 'assembly' or opt_down contains 'assembly'
      assign assembly_option_index = forloop.index0
    endif
    if opt_down contains 'hanger'
      assign hanger_option_index = forloop.index0
    endif
    if opt_down == 'color' or opt_down == 'colour'
      assign color_option_index = forloop.index0
    endif
  endfor
  assign is_variant_picker = false
  if combined_option_index != nil
    assign is_variant_picker = true
  elsif size_option_index != nil
    assign is_variant_picker = true
  endif
  assign handle_down = product.handle | downcase
  assign title_down = product.title | downcase
  assign is_sticker = false
  assign is_prodigi = false
  if product.tags contains 'prodigi' or product.tags contains 'printful'
    assign is_prodigi = true
    assign is_variant_picker = false
  endif
  if handle_down contains 'sticker'
    assign is_sticker = true
    assign is_variant_picker = false
  endif
  assign fixed_orient = blank
  if handle_down contains 'foam-portrait'
    assign fixed_orient = 'portrait'
  elsif handle_down contains 'foam-landscape'
    assign fixed_orient = 'landscape'
  elsif handle_down contains 'foam-square'
    assign fixed_orient = 'square'
  endif
  assign is_framed = false
  if frame_option_index != nil or handle_down contains 'framed'
    assign is_framed = true
  endif
  assign is_poster = false
  if is_framed == false
    if handle_down contains 'poster' or title_down contains 'poster'
      assign is_poster = true
    endif
  endif
  assign is_framed_canvas = false
  if handle_down == 'framed-canvas' or title_down == 'framed canvas'
    assign is_framed_canvas = true
  endif
  assign is_metal_framed = false
  if handle_down contains 'metal-framed'
    assign is_metal_framed = true
  endif
  assign is_wooden_framed = false
  if is_framed_canvas == false and is_metal_framed == false
    if is_framed and handle_down contains 'wooden'
      assign is_wooden_framed = true
    elsif is_framed and handle_down contains 'fine-art-framed'
      assign is_wooden_framed = true
    endif
  endif
  assign is_hanger = false
  if hanger_option_index != nil or handle_down contains 'hanger'
    assign is_hanger = true
  endif
  assign category_label = 'Wall art'
  assign category_url = '/collections/wall-art'
  if is_framed_canvas
    assign category_label = 'Framed canvas'
    assign category_url = '/collections/framed-canvas'
  elsif is_metal_framed
    assign category_label = 'Metal framed prints'
    assign category_url = '/collections/framed-prints'
  elsif is_wooden_framed
    assign category_label = 'Wooden framed prints'
    assign category_url = '/collections/framed-prints'
  elsif is_framed
    assign category_label = 'Framed prints'
    assign category_url = '/collections/framed-prints'
  elsif is_hanger
    assign category_label = 'Posters with hangers'
    assign category_url = '/collections/posters-with-hangers'
  elsif is_poster
    assign category_label = 'Posters'
    assign category_url = '/collections/posters'
  elsif handle_down contains 'acrylic'
    assign category_label = 'Acrylic prints'
    assign category_url = '/collections/acrylic-prints'
  elsif handle_down contains 'aluminum' or handle_down contains 'aluminium'
    assign category_label = 'Metal / aluminium'
    assign category_url = '/collections/aluminum-prints'
  elsif handle_down contains 'wood-print' or handle_down == 'wood-prints'
    assign category_label = 'Wood prints'
    assign category_url = '/collections/wood-prints'
  elsif handle_down contains 'foam'
    assign category_label = 'Foam prints'
    assign category_url = '/collections/foam-prints'
  elsif handle_down contains 'canvas'
    assign category_label = 'Canvas prints'
    assign category_url = '/collections/canvas-prints'
  endif
  assign display_title = product.title
  if is_framed_canvas
    assign display_title = 'Framed canvas'
  elsif handle_down contains 'classic-semi-glossy-paper-wooden-framed'
    assign display_title = 'Classic Semi-Glossy Wooden Framed Print'
  elsif handle_down contains 'premium-semi-glossy-paper-wooden-framed'
    assign display_title = 'Premium Semi-Glossy Wooden Framed Print'
  elsif handle_down == 'fine-art-framed-poster'
    assign display_title = 'Fine Art Wooden Framed Print'
  elsif is_metal_framed
    assign display_title = 'Classic Semi-Glossy Metal Framed Print'
  elsif handle_down == 'premium-matte-paper-poster-with-hanger'
    assign display_title = 'Premium Matte Poster with Hanger'
  elsif handle_down == 'aluminum-print'
    assign display_title = 'Aluminum print'
  elsif handle_down == 'brushed-aluminum-print'
    assign display_title = 'Brushed aluminum print'
  elsif handle_down == 'acrylic-print'
    assign display_title = 'Acrylic print'
  elsif handle_down == 'wood-prints'
    assign display_title = 'Wood print'
  elsif handle_down == 'foam-portrait'
    assign display_title = 'Foam print · Portrait'
  elsif handle_down == 'foam-landscape'
    assign display_title = 'Foam print · Landscape'
  elsif handle_down == 'foam-square'
    assign display_title = 'Foam print · Square'
  endif
  assign size_count = 0
  if combined_option_index != nil
    assign size_count = product.options_with_values[combined_option_index].values.size | divided_by: 2
  elsif size_option_index != nil
    assign size_count = product.options_with_values[size_option_index].values.size
  endif
  assign variant_map_asset = blank
  if handle_down == 'premium-semi-glossy-paper-wooden-framed-poster-premium-1'
    assign variant_map_asset = 'framed-premium-variants.json'
  elsif handle_down == 'classic-semi-glossy-paper-wooden-framed-poster-bestseller-1'
    assign variant_map_asset = 'framed-classic-variants.json'
  endif
  assign show_orient_ui = false
  if fixed_orient == blank
    if combined_option_index != nil or orientation_option_index != nil
      assign show_orient_ui = true
    endif
  endif
-%}

<section class="main-product{% if is_variant_picker %} main-product--flush{% endif %}" data-section-id="{{ section.id }}">
  {% unless is_prodigi or is_sticker %}
    {% render 'gelato-customization' %}
  {% endunless %}

  {% if is_variant_picker %}
    <div class="pb-canvas" id="Product-{{ section.id }}" data-canvas-picker data-section="{{ section.id }}">
      <div class="pb-canvas__hero">
        <div class="page-width pb-canvas__hero-inner">
          <nav class="pb-canvas__crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/collections/wall-art">Wall art</a>
            <span>/</span>
            <a href="{{ category_url }}">{{ category_label }}</a>
            <span>/</span>
            <span>{{ display_title }}</span>
          </nav>
          <h1 class="pb-canvas__title">{{ display_title }}</h1>
          <p class="pb-canvas__subtitle">
            {% if is_hanger %}
              Poster with hanger — pick hanger colour, orientation and size
            {% elsif is_metal_framed %}
              Metal framed print — pick orientation and size
            {% elsif is_framed_canvas %}
              Canvas in a tray frame — pick frame colour, orientation and size
            {% elsif is_wooden_framed %}
              Wooden framed print — pick frame colour, orientation and size
              {%- if assembly_option_index != nil %} · assembly{% endif -%}
            {% elsif fixed_orient != blank %}
              Foam board print — pick size
              {%- if color_option_index != nil %} and edge colour{% endif -%}
            {% elsif handle_down contains 'wood-print' %}
              Wood print — pick thickness, orientation and size
            {% elsif handle_down contains 'acrylic' %}
              Acrylic print — pick orientation and size
            {% elsif handle_down contains 'aluminum' or handle_down contains 'aluminium' %}
              Metal print — pick orientation and size
            {% elsif is_poster %}
              Pick orientation and size
            {% elsif is_framed %}
              Pick options and size
            {% else %}
              Pick orientation and size
              {%- if thickness_option_index != nil %} · thickness{% endif -%}
            {% endif %}
            {%- if size_count > 0 %} · {{ size_count }} sizes{% endif -%}
            {%- if product.price_varies %} · from {{ product.price_min | money }}{% endif -%}.
            Then personalize with your photo.
          </p>
        </div>
      </div>

      <div class="page-width pb-canvas__layout">
        <div class="pb-canvas__media">
          <div class="pb-canvas__gallery" data-product-gallery>
            <div class="pb-canvas__media-frame" data-product-media>
              {% if current_variant.featured_media %}
                {% assign media = current_variant.featured_media %}
              {% else %}
                {% assign media = product.featured_media %}
              {% endif %}
              {% if media %}
                <img
                  class="product__image"
                  src="{{ media | image_url: width: 1100 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="1100"
                  height="1100"
                  data-product-image
                >
              {% else %}
                <div class="pb-canvas__media-empty" data-product-image-fallback>
                  {% render 'mock-image', product: product, class: 'pb-canvas__media-mock', width: 900 %}
                  <p class="pb-canvas__media-empty-title">Sample mockup</p>
                  <p class="pb-canvas__media-empty-copy muted">
                    Choose size, then use <strong>Personalize design</strong> to upload your photo and see the live preview.
                  </p>
                </div>
              {% endif %}
            </div>
            <button type="button" class="pb-gallery__nav pb-gallery__nav--prev" data-gallery-prev aria-label="Previous image" hidden>
              <span aria-hidden="true">‹</span>
            </button>
            <button type="button" class="pb-gallery__nav pb-gallery__nav--next" data-gallery-next aria-label="Next image" hidden>
              <span aria-hidden="true">›</span>
            </button>
            <div class="pb-gallery__dots" data-gallery-dots hidden></div>
          </div>
        </div>

        <div class="pb-canvas__panel">
          {% form 'product', product, id: 'product-form', class: 'pb-canvas__form' %}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
            <input type="hidden" name="quantity" value="1">

            {% if show_orient_ui %}
              <div class="pb-canvas__step">
                <p class="pb-canvas__label">Orientation</p>
                <div class="pb-canvas__orient" role="radiogroup" aria-label="Orientation">
                  <button type="button" class="pb-orient" data-orient="portrait" aria-pressed="false">Portrait</button>
                  <button type="button" class="pb-orient" data-orient="landscape" aria-pressed="false">Landscape</button>
                  <button type="button" class="pb-orient" data-orient="square" aria-pressed="false">Square</button>
                </div>
              </div>
            {% elsif fixed_orient != blank %}
              <input type="hidden" data-fixed-orient value="{{ fixed_orient }}">
            {% endif %}

            {% if thickness_option_index != nil %}
              <div class="pb-canvas__step">
                <p class="pb-canvas__label">{% if handle_down contains 'wood' %}Thickness{% else %}Wrap{% endif %}</p>
                <div class="pb-canvas__thick" role="radiogroup" aria-label="Thickness">
                  {% for value in product.options_with_values[thickness_option_index].values %}
                    {% assign thick_down = value | downcase %}
                    {% assign thick_key = value | handleize %}
                    {% if thick_down contains 'thick' %}
                      {% assign thick_key = 'thick' %}
                    {% elsif thick_down contains 'slim' or thick_down contains 'thin' %}
                      {% assign thick_key = 'slim' %}
                    {% elsif thick_down contains '10' %}
                      {% assign thick_key = '10mm' %}
                    {% elsif thick_down contains '20' %}
                      {% assign thick_key = '20mm' %}
                    {% endif %}
                    <button type="button" class="pb-thick" data-thickness="{{ thick_key }}" data-thickness-label="{{ value | escape }}" aria-pressed="false">
                      <strong>{{ value }}</strong>
                      <span>{% if thick_key == 'slim' %}~2 cm{% elsif thick_key == 'thick' %}~4 cm{% else %}Thickness{% endif %}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if frame_option_index != nil %}
              <div class="pb-canvas__step">
                <p class="pb-canvas__label">Frame colour</p>
                <div class="pb-canvas__frames" role="radiogroup" aria-label="Frame colour">
                  {% for value in product.options_with_values[frame_option_index].values %}
                    {% assign frame_down = value | downcase %}
                    {% assign frame_key = 'frame' %}
                    {% if frame_down contains 'white' %}
                      {% assign frame_key = 'white' %}
                    {% elsif frame_down contains 'dark' %}
                      {% assign frame_key = 'dark-wood' %}
                    {% elsif frame_down contains 'wood' %}
                      {% assign frame_key = 'wood' %}
                    {% elsif frame_down contains 'black' %}
                      {% assign frame_key = 'black' %}
                    {% else %}
                      {% assign frame_key = value | handleize %}
                    {% endif %}
                    <button
                      type="button"
                      class="pb-frame"
                      data-frame="{{ frame_key }}"
                      data-frame-label="{{ value | escape }}"
                      aria-pressed="false"
                    >
                      <span class="pb-frame__swatch pb-frame__swatch--{{ frame_key }}" aria-hidden="true"></span>
                      <span class="pb-frame__label">{{ value | remove: ' frame' | remove: ' Frame' }}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if hanger_option_index != nil %}
              <div class="pb-canvas__step">
                <p class="pb-canvas__label">Hanger colour</p>
                <div class="pb-canvas__frames" role="radiogroup" aria-label="Hanger colour">
                  {% for value in product.options_with_values[hanger_option_index].values %}
                    {% assign hanger_down = value | downcase %}
                    {% assign hanger_key = value | handleize %}
                    {% if hanger_down contains 'white' %}
                      {% assign hanger_key = 'white' %}
                    {% elsif hanger_down contains 'dark' %}
                      {% assign hanger_key = 'dark-wood' %}
                    {% elsif hanger_down contains 'natural' or hanger_down contains 'wood' %}
                      {% assign hanger_key = 'wood' %}
                    {% elsif hanger_down contains 'black' %}
                      {% assign hanger_key = 'black' %}
                    {% endif %}
                    <button
                      type="button"
                      class="pb-frame"
                      data-hanger="{{ hanger_key }}"
                      data-hanger-label="{{ value | escape }}"
                      aria-pressed="false"
                    >
                      <span class="pb-frame__swatch pb-frame__swatch--{{ hanger_key }}" aria-hidden="true"></span>
                      <span class="pb-frame__label">{{ value | remove: ' wall hanger' | remove: ' Wall hanger' | remove: ' Wall Hanger' }}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if color_option_index != nil %}
              <div class="pb-canvas__step">
                <p class="pb-canvas__label">Edge colour</p>
                <div class="pb-canvas__frames" role="radiogroup" aria-label="Edge colour">
                  {% for value in product.options_with_values[color_option_index].values %}
                    {% assign color_key = value | handleize %}
                    <button
                      type="button"
                      class="pb-frame"
                      data-color="{{ color_key }}"
                      data-color-label="{{ value | escape }}"
                      aria-pressed="false"
                    >
                      <span class="pb-frame__swatch pb-frame__swatch--{{ color_key }}" aria-hidden="true"></span>
                      <span class="pb-frame__label">{{ value | capitalize }}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            {% if assembly_option_index != nil %}
              <div class="pb-canvas__step">
                <p class="pb-canvas__label">Assembly</p>
                <div class="pb-canvas__thick" role="radiogroup" aria-label="Assembly">
                  {% for value in product.options_with_values[assembly_option_index].values %}
                    {% assign assembly_down = value | downcase %}
                    {% assign assembly_key = value | handleize %}
                    {% if assembly_down contains 'ready' %}
                      {% assign assembly_key = 'ready' %}
                    {% elsif assembly_down contains 'not' or assembly_down contains 'unassembled' %}
                      {% assign assembly_key = 'flat' %}
                    {% endif %}
                    <button
                      type="button"
                      class="pb-thick"
                      data-assembly="{{ assembly_key }}"
                      data-assembly-label="{{ value | escape }}"
                      aria-pressed="false"
                    >
                      <strong>{% if assembly_key == 'ready' %}Ready to hang{% else %}Flat pack{% endif %}</strong>
                      <span>{{ value }}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            <div class="pb-canvas__step pb-canvas__sizes-wrap">
              <div class="pb-canvas__sizes-head">
                <span>Size</span>
                <span class="muted" data-size-hint></span>
              </div>
              <div class="pb-size-list" data-size-grid role="listbox" aria-label="Size"></div>
            </div>

            <div class="pb-canvas__buybox">
              <div>
                {% if product.price_varies %}
                  <p class="pb-canvas__from">From {{ product.price_min | money }}</p>
                {% endif %}
                <p class="pb-canvas__price" data-product-price>{{ current_variant.price | money }}</p>
                <p class="pb-canvas__selection muted" data-selection-summary></p>
              </div>
              <div class="pb-canvas__actions">
                <button
                  type="submit"
                  name="add"
                  class="button button--primary btn-addtocart pb-canvas__cta"
                  data-add-to-cart
                  {% if current_variant.available == false %}disabled{% endif %}
                >
                  {% if current_variant.available %}
                    {{ 'products.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.sold_out' | t }}
                  {% endif %}
                </button>
              </div>
            </div>
            <p class="pb-canvas__vat muted">
              Use <strong>Personalize design</strong> to upload your photo and see the live mockup, then add to cart.
            </p>
            <input
              type="hidden"
              name="properties[Personalised print]"
              value="We have your uploaded image and will print from the mockup you created — not the stock product photo."
            >
          {% endform %}

          <script type="application/json" data-variant-map>
            {
              "sizeOptionIndex": {% if size_option_index != nil %}{{ size_option_index }}{% else %}null{% endif %},
              "orientationOptionIndex": {% if orientation_option_index != nil %}{{ orientation_option_index }}{% else %}null{% endif %},
              "combinedOptionIndex": {% if combined_option_index != nil %}{{ combined_option_index }}{% else %}null{% endif %},
              "thicknessOptionIndex": {% if thickness_option_index != nil %}{{ thickness_option_index }}{% else %}null{% endif %},
              "frameOptionIndex": {% if frame_option_index != nil %}{{ frame_option_index }}{% else %}null{% endif %},
              "assemblyOptionIndex": {% if assembly_option_index != nil %}{{ assembly_option_index }}{% else %}null{% endif %},
              "hangerOptionIndex": {% if hanger_option_index != nil %}{{ hanger_option_index }}{% else %}null{% endif %},
              "colorOptionIndex": {% if color_option_index != nil %}{{ color_option_index }}{% else %}null{% endif %},
              "fixedOrient": {% if fixed_orient != blank %}{{ fixed_orient | json }}{% else %}null{% endif %},
              "variantMapUrl": {% if variant_map_asset != blank %}{{ variant_map_asset | asset_url | json }}{% else %}null{% endif %},
              "galleryMap": {% if handle_down contains 'canvas' and handle_down != 'framed-canvas' %}{% render 'canvas-variant-gallery-data' %}{% else %}{}{% endif %},
              "variants": [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "available": {{ variant.available | json }},
                    "price": {{ variant.price | json }},
                    "priceFormatted": {{ variant.price | money | json }},
                    "title": {{ variant.title | json }},
                    "options": {{ variant.options | json }},
                    "featuredImage": {% if variant.featured_media %}{{ variant.featured_media | image_url: width: 1100 | json }}{% elsif product.featured_media %}{{ product.featured_media | image_url: width: 1100 | json }}{% else %}null{% endif %}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
          </script>
        </div>
      </div>

      {% if product.description != blank %}
        <div class="page-width pb-canvas__about">
          <h2>
            {% if is_framed_canvas %}
              About this framed canvas
            {% elsif is_wooden_framed %}
              About this wooden framed print
            {% elsif is_framed %}
              About this framed print
            {% elsif is_poster %}
              About this poster
            {% else %}
              About these canvas prints
            {% endif %}
          </h2>
          <div class="rte">{{ product.description }}</div>
        </div>
      {% endif %}

      <div class="page-width pb-canvas__features">
        <article>
          <h3>Fully customise your print</h3>
          <p>Use Personalize design to upload your photo, preview on a live mockup, then add to cart. We print and ship to your door.</p>
        </article>
        {% if is_framed_canvas %}
          <article>
            <h3>Tray frame · three colours</h3>
            <p>Wood, dark wood or black tray frames that give your canvas a clean gallery finish.</p>
          </article>
        {% elsif is_wooden_framed %}
          <article>
            <h3>Wooden frame · four colours</h3>
            <p>White, wood, dark wood or black wooden frames — metal framed prints coming soon as a separate range.</p>
          </article>
        {% elsif is_framed %}
          <article>
            <h3>Four frame colours</h3>
            <p>White, wood, dark wood or black — match your room and let the print take centre stage.</p>
          </article>
        {% elsif is_poster %}
          <article>
            <h3>Premium paper finish</h3>
            <p>This finish is selected on the posters page — more paper options coming soon as separate products.</p>
          </article>
        {% else %}
          <article>
            <h3>Slim or thick wrap</h3>
            <p>Choose a modern slim edge (~2 cm) or a deeper gallery wrap (~4 cm) for every size.</p>
          </article>
        {% endif %}
        <article>
          <h3>Many sizes &amp; formats</h3>
          <p>Portrait, landscape and square options across {{ size_count }} sizes — pick what fits your wall.</p>
        </article>
      </div>
    </div>

  {% else %}
    {%- liquid
      assign is_mug = false
      assign is_bottle = false
      assign is_phone_case = false
      assign is_tote = false
      assign is_sticker_gift = false
      assign is_prodigi_gift = false
      if handle_down contains 'mug'
        assign is_mug = true
      endif
      if handle_down contains 'bottle'
        assign is_bottle = true
      endif
      if handle_down contains 'case'
        assign is_phone_case = true
      endif
      if handle_down contains 'tote'
        assign is_tote = true
      endif
      if handle_down contains 'sticker'
        assign is_sticker_gift = true
      endif
      if is_prodigi or is_sticker_gift
        assign is_prodigi_gift = true
      endif
      assign gift_crumb_label = 'Home & gifts'
      assign gift_crumb_url = '/collections/home-gifts'
      assign prodigi_caption = product.title
      if is_mug
        assign gift_crumb_label = 'Mugs'
        assign gift_crumb_url = '/collections/mugs'
      elsif is_bottle
        assign gift_crumb_label = 'Water bottles'
        assign gift_crumb_url = '/collections/water-bottles'
      elsif is_phone_case
        assign gift_crumb_label = 'Phone cases'
        assign gift_crumb_url = '/collections/phone-cases'
      elsif is_tote
        assign gift_crumb_label = 'Tote bags'
        assign gift_crumb_url = '/collections/tote-bags'
      elsif is_sticker_gift
        assign gift_crumb_label = 'Stickers'
        assign gift_crumb_url = '/collections/stickers'
        assign prodigi_caption = 'Kiss-cut vinyl · white backing'
      elsif handle_down contains 'tattoo'
        assign gift_crumb_label = 'Temporary tattoos'
        assign gift_crumb_url = '/collections/tattoos'
        assign prodigi_caption = 'Skin-safe waterslide tattoo'
      elsif handle_down contains 'magnet'
        assign gift_crumb_label = 'Magnets'
        assign gift_crumb_url = '/collections/magnets'
        assign prodigi_caption = 'Photo fridge magnet'
      elsif handle_down contains 'tile'
        assign gift_crumb_label = 'Photo tiles'
        assign gift_crumb_url = '/collections/photo-tiles'
        assign prodigi_caption = 'Restickable framed photo tile'
      elsif handle_down contains 'cushion'
        assign gift_crumb_label = 'Cushions'
        assign gift_crumb_url = '/collections/cushions'
        assign prodigi_caption = 'Faux suede photo cushion'
      elsif handle_down contains 'prism'
        assign gift_crumb_label = 'Acrylic prisms'
        assign gift_crumb_url = '/collections/acrylic-prisms'
        assign prodigi_caption = 'Freestanding acrylic photo block'
      elsif handle_down contains 'jigsaw'
        assign gift_crumb_label = 'Jigsaws'
        assign gift_crumb_url = '/collections/jigsaws'
        assign prodigi_caption = 'Jigsaw in a metal tin'
      elsif handle_down contains 'hand-towel'
        assign gift_crumb_label = 'Towels'
        assign gift_crumb_url = '/collections/towels'
        assign prodigi_caption = 'Sublimation hand towel · 28″ × 16″'
      elsif handle_down contains 'towel'
        assign gift_crumb_label = 'Towels'
        assign gift_crumb_url = '/collections/towels'
        assign prodigi_caption = 'All-over sublimation beach towel'
      endif
    -%}
    <div class="page-width product{% if is_prodigi_gift %} product--sticker{% endif %}" id="Product-{{ section.id }}">
      <div class="product__media">
        <div class="product__media-frame" data-product-media>
          {% if current_variant.featured_media %}
            {% assign media = current_variant.featured_media %}
          {% else %}
            {% assign media = product.featured_media %}
          {% endif %}
          {% if media %}
            <img
              class="product__image"
              src="{{ media | image_url: width: 1400 }}"
              alt="{{ media.alt | default: product.title | escape }}"
              width="{{ media.width }}"
              height="{{ media.height }}"
              data-product-image
            >
          {% else %}
            {% render 'mock-image', product: product, class: 'product__image', width: 900 %}
          {% endif %}
        </div>
        {% if is_prodigi_gift %}
          <p class="product__media-caption muted">{{ prodigi_caption }}</p>
        {% endif %}
      </div>
      <div class="product__info">
        <nav class="pb-canvas__crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/collections/home-gifts">Home &amp; gifts</a>
          <span>/</span>
          <a href="{{ gift_crumb_url }}">{{ gift_crumb_label }}</a>
          <span>/</span>
          <span>{{ product.title }}</span>
        </nav>
        <h1 class="product__title">{{ product.title }}</h1>
        <p class="product__price" data-product-price>{{ current_variant.price | money }}</p>
        {% if is_prodigi_gift %}
          <p class="product__lead">{{ 'products.lead' | t }}</p>
        {% endif %}
        {% if product.description != blank %}
          <div class="product__description rte">{{ product.description }}</div>
        {% endif %}
        {% form 'product', product, id: 'product-form', class: 'product-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
          {% unless product.has_only_default_variant %}
            {% if color_option_index != nil and is_mug or color_option_index != nil and is_tote %}
              <div class="pb-canvas__step product-form__color">
                <p class="pb-canvas__label">{% if handle_down contains 'color-inside' %}Inside colour{% else %}Colour{% endif %}</p>
                <div class="pb-canvas__frames" role="radiogroup" aria-label="{% if handle_down contains 'color-inside' %}Inside colour{% else %}Colour{% endif %}" data-gift-color>
                  {% for value in product.options_with_values[color_option_index].values %}
                    {% assign color_down = value | downcase %}
                    {% assign color_key = value | handleize %}
                    {% if color_down contains 'yellow' %}
                      {% assign color_key = 'yellow' %}
                    {% elsif color_down contains 'pink' %}
                      {% assign color_key = 'pink' %}
                    {% elsif color_down contains 'green' %}
                      {% assign color_key = 'green' %}
                    {% elsif color_down contains 'red' %}
                      {% assign color_key = 'red' %}
                    {% elsif color_down contains 'black' %}
                      {% assign color_key = 'black' %}
                    {% elsif color_down contains 'blue' %}
                      {% assign color_key = 'blue' %}
                    {% elsif color_down contains 'white' %}
                      {% assign color_key = 'white' %}
                    {% endif %}
                    <button
                      type="button"
                      class="pb-frame{% if product.options_with_values[color_option_index].selected_value == value %} is-selected{% endif %}"
                      data-gift-color-value="{{ value | escape }}"
                      aria-pressed="{% if product.options_with_values[color_option_index].selected_value == value %}true{% else %}false{% endif %}"
                    >
                      <span class="pb-frame__swatch pb-frame__swatch--{{ color_key }}" aria-hidden="true"></span>
                      <span class="pb-frame__label">{{ value | remove: 'Ceramic ' }}</span>
                    </button>
                  {% endfor %}
                </div>
                <select name="options[{{ product.options_with_values[color_option_index].name | escape }}]" class="visually-hidden" data-gift-color-select aria-hidden="true" tabindex="-1">
                  {% for value in product.options_with_values[color_option_index].values %}
                    <option value="{{ value | escape }}" {% if product.options_with_values[color_option_index].selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              </div>
            {% else %}
              <div class="product-form__variants">
                {% for option in product.options_with_values %}
                  <label class="field-label" for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                  <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]" class="field-select" data-option-select data-option-index="{{ forloop.index0 }}">
                    {% for value in option.values %}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {% endfor %}
                  </select>
                {% endfor %}
              </div>
            {% endif %}
          {% endunless %}
          {% if is_prodigi_gift %}
            <div class="photo-upload" data-sticker-upload>
              <label class="field-label" for="ArtworkUpload-{{ section.id }}">{{ 'products.your_photo' | t }}</label>
              <input
                id="ArtworkUpload-{{ section.id }}"
                class="photo-upload__input"
                type="file"
                name="properties[Artwork]"
                accept="image/jpeg,image/png"
                data-sticker-file
                required
              >
              <p class="pb-canvas__vat muted">
                {{ 'products.upload_confirm' | t }}
              </p>
              <p class="photo-upload__status" data-sticker-status hidden></p>
              <input type="hidden" name="properties[Artwork name]" value="" data-sticker-filename>
              <input
                type="hidden"
                name="properties[Personalised print]"
                value="We’ll mock up your design and confirm it with you before dispatch — not the stock product photo."
              >
            </div>
          {% endif %}
          <button
            type="submit"
            name="add"
            class="button button--primary btn-addtocart"
            data-add-to-cart
            {% if is_prodigi_gift %}data-sticker-gate data-sticker-ready="false"{% endif %}
            {% if current_variant.available == false or is_prodigi_gift %}disabled{% endif %}
          >
            {% if current_variant.available %}
              {{ 'products.add_to_cart' | t }}
            {% else %}
              {{ 'products.sold_out' | t }}
            {% endif %}
          </button>
        {% endform %}
      </div>
    </div>
    {% if color_option_index != nil and is_mug or color_option_index != nil and is_tote %}
      <script type="application/json" data-gift-variants>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "priceFormatted": {{ variant.price | money | json }},
              "options": {{ variant.options | json }},
              "featuredImage": {% if variant.featured_media %}{{ variant.featured_media | image_url: width: 1100 | json }}{% elsif product.featured_media %}{{ product.featured_media | image_url: width: 1100 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
      <script>
        (function () {
          var root = document.getElementById('Product-{{ section.id }}');
          if (!root) return;
          var mapEl = document.querySelector('[data-gift-variants]');
          if (!mapEl) return;
          var variants = JSON.parse(mapEl.textContent);
          var select = root.querySelector('[data-gift-color-select]');
          var idInput = root.querySelector('[data-variant-id]');
          var priceEl = root.querySelector('[data-product-price]');
          var imageEl = root.querySelector('[data-product-image]') || root.querySelector('.product__image');
          var addBtn = root.querySelector('[data-add-to-cart]');
          var btns = root.querySelectorAll('[data-gift-color-value]');
          function apply(value) {
            if (select) select.value = value;
            var v = variants.find(function (x) { return x.options[0] === value; }) || variants[0];
            if (!v) return;
            if (idInput) idInput.value = v.id;
            if (priceEl) priceEl.textContent = v.priceFormatted;
            if (imageEl && v.featuredImage && !root.querySelector('[data-sticker-preview]')) {
              imageEl.src = v.featuredImage;
              imageEl.srcset = '';
            }
            if (addBtn && addBtn.hasAttribute('data-sticker-gate')) {
              if (!v.available) {
                addBtn.disabled = true;
                addBtn.textContent = (window.STORE_I18N && window.STORE_I18N.soldOut) || 'Sold out';
              } else {
                var ready = addBtn.getAttribute('data-sticker-ready') === 'true';
                addBtn.disabled = !ready;
                addBtn.textContent = (window.STORE_I18N && window.STORE_I18N.addToCart) || 'Add to cart';
              }
            } else if (addBtn) {
              addBtn.disabled = !v.available;
              addBtn.textContent = v.available ? ((window.STORE_I18N && window.STORE_I18N.addToCart) || 'Add to cart') : ((window.STORE_I18N && window.STORE_I18N.soldOut) || 'Sold out');
            }
            btns.forEach(function (b) {
              var on = b.getAttribute('data-gift-color-value') === value;
              b.classList.toggle('is-selected', on);
              b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
          }
          btns.forEach(function (btn) {
            btn.addEventListener('click', function () {
              apply(btn.getAttribute('data-gift-color-value'));
            });
          });
        })();
      </script>
    {% elsif product.has_only_default_variant == false %}
      <script type="application/json" data-gift-variants>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "priceFormatted": {{ variant.price | money | json }},
              "options": {{ variant.options | json }},
              "featuredImage": {% if variant.featured_media %}{{ variant.featured_media | image_url: width: 1100 | json }}{% elsif product.featured_media %}{{ product.featured_media | image_url: width: 1100 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
      <script>
        (function () {
          var root = document.getElementById('Product-{{ section.id }}');
          if (!root) return;
          var mapEl = document.querySelector('[data-gift-variants]');
          if (!mapEl) return;
          var variants = JSON.parse(mapEl.textContent);
          var selects = root.querySelectorAll('[data-option-select]');
          var idInput = root.querySelector('[data-variant-id]');
          var priceEl = root.querySelector('[data-product-price]');
          var imageEl = root.querySelector('[data-product-image]') || root.querySelector('.product__image');
          var addBtn = root.querySelector('[data-add-to-cart]');
          function currentOptions() {
            var opts = [];
            selects.forEach(function (s) { opts.push(s.value); });
            return opts;
          }
          function apply() {
            var opts = currentOptions();
            var v = variants.find(function (x) {
              return opts.every(function (o, i) { return x.options[i] === o; });
            }) || variants[0];
            if (!v) return;
            if (idInput) idInput.value = v.id;
            if (priceEl) priceEl.textContent = v.priceFormatted;
            if (imageEl && v.featuredImage && !root.querySelector('[data-sticker-preview]')) {
              imageEl.src = v.featuredImage;
              imageEl.srcset = '';
            }
            if (addBtn && addBtn.hasAttribute('data-sticker-gate')) {
              if (!v.available) {
                addBtn.disabled = true;
                addBtn.textContent = (window.STORE_I18N && window.STORE_I18N.soldOut) || 'Sold out';
              } else {
                var ready = addBtn.getAttribute('data-sticker-ready') === 'true';
                addBtn.disabled = !ready;
                addBtn.textContent = (window.STORE_I18N && window.STORE_I18N.addToCart) || 'Add to cart';
              }
            } else if (addBtn) {
              addBtn.disabled = !v.available;
              addBtn.textContent = v.available ? ((window.STORE_I18N && window.STORE_I18N.addToCart) || 'Add to cart') : ((window.STORE_I18N && window.STORE_I18N.soldOut) || 'Sold out');
            }
          }
          selects.forEach(function (s) { s.addEventListener('change', apply); });
        })();
      </script>
    {% endif %}
  {% endif %}
</section>

{% if is_variant_picker %}
  {% render 'variant-picker-script', section_id: section.id %}
{% endif %}

