<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
      {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name or page_title contains settings.brand_name %} &ndash; {{ settings.brand_name | default: shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%} Open Graph {%- endcomment -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    {% if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {% endif %}
    {% if template.name == 'product' %}
      <meta property="og:type" content="product">
      {% if product.featured_media %}
        <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:alt" content="{{ product.featured_media.alt | default: product.title | escape }}">
      {% endif %}
      <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency }}">
      <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
    {% elsif template.name == 'collection' and collection.image %}
      <meta property="og:type" content="website">
      <meta property="og:image" content="https:{{ collection.image | image_url: width: 1200 }}">
    {% else %}
      <meta property="og:type" content="website">
    {% endif %}

    {%- comment -%} Twitter Card {%- endcomment -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title | escape }}">
    {% if page_description %}
      <meta name="twitter:description" content="{{ page_description | escape }}">
    {% endif %}
    {% if template.name == 'product' and product.featured_media %}
      <meta name="twitter:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
    {% endif %}

    {%- comment -%} Organization structured data {%- endcomment -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        {% if settings.brand_logo %}
          "logo": {{ settings.brand_logo | image_url: width: 600 | prepend: 'https:' | json }},
        {% endif %}
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer service",
          "url": "{{ shop.url }}/pages/contact"
        }
      }
    </script>

    <link rel="icon" href="{{ 'snapdaddy-favicon.png' | asset_url }}" type="image/png">
    <link rel="apple-touch-icon" href="{{ 'snapdaddy-favicon.png' | asset_url }}">
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      :root {
        /* Studio Ink */
        --color-primary: {{ settings.color_primary }};
        --color-brand-nav: {{ settings.color_brand_nav }};
        --color-brand-nav-hover: {{ settings.color_brand_nav_hover }};
        --color-accent: {{ settings.color_accent }};
        --color-secondary: {{ settings.color_secondary }};
        --color-dark: {{ settings.color_dark }};
        --color-light: {{ settings.color_light }};
        --color-muted: {{ settings.color_muted }};
        --color-border: {{ settings.color_border }};
        --background: {{ settings.color_light }};
        --foreground: {{ settings.color_dark }};
        --ink: {{ settings.color_dark }};
        --paper: {{ settings.color_light }};
        --surface: #ffffff;
        --magenta: {{ settings.color_primary }};
        --cyan: {{ settings.color_accent }};
        --mint: {{ settings.color_secondary }};
        --electric: {{ settings.color_accent }};
      }
    </style>
  </head>
  <body class="template-{{ template.name }}">
    {% sections 'header-group' %}
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
    <script>
      window.STORE_DESIGN_PREVIEW = {
        supabaseUrl: {{ settings.supabase_url | json }},
        anonKey: {{ settings.supabase_anon_key | json }}
      };
      window.STORE_I18N = {
        addToCart: {{ 'products.add_to_cart' | t | json }},
        soldOut: {{ 'products.sold_out' | t | json }},
        uploadType: {{ 'products.upload_type' | t | json }},
        fileTooLarge: {{ 'products.file_too_large' | t | json }},
        fileAttached: {{ 'products.file_attached' | t | json }}
      };
      document.addEventListener('change', function (e) {
        if (e.target && e.target.matches('[data-localization-select]') && e.target.form) {
          e.target.form.submit();
        }
      });
    </script>
    <script src="{{ 'design-preview.js' | asset_url }}" defer></script>
    <script src="{{ 'sticker-preview.js' | asset_url }}" defer></script>
  </body>
</html>
