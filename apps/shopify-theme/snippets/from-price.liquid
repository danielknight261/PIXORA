{%- comment -%}
  Outputs "From £X" using the cheapest price — never the first item in a list.
  Accepts: product, collection, and/or handle (collection handle first, else product).
{%- endcomment -%}
{%- liquid
  assign min_cents = blank

  if collection != blank
    if collection.price_min != blank
      assign min_cents = collection.price_min
    else
      for p in collection.products
        assign p_min = p.price_min | plus: 0
        assign cur_min = min_cents | default: 999999999 | plus: 0
        if min_cents == blank or p_min < cur_min
          assign min_cents = p.price_min
        endif
      endfor
    endif
  endif

  if min_cents == blank and product != blank
    assign min_cents = product.price_min
  endif

  if min_cents == blank and handle != blank
    assign resolved_collection = collections[handle]
    if resolved_collection != blank
      if resolved_collection.price_min != blank
        assign min_cents = resolved_collection.price_min
      else
        for p in resolved_collection.products
          assign p_min = p.price_min | plus: 0
          assign cur_min = min_cents | default: 999999999 | plus: 0
          if min_cents == blank or p_min < cur_min
            assign min_cents = p.price_min
          endif
        endfor
      endif
    endif
    if min_cents == blank
      assign resolved_product = all_products[handle]
      if resolved_product != blank
        assign min_cents = resolved_product.price_min
      endif
    endif
  endif
-%}
{%- if min_cents != blank -%}
  {{ 'general.from' | t }} {{ min_cents | money }}
{%- endif -%}
