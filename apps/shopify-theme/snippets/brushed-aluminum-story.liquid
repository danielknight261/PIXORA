{%- comment -%}
  Photobox-style stepped rows for brushed aluminum / metallic prints.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.brushed_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'brushed-story-stack.webp' | asset_url }}"
          width="1000"
          height="1000"
          alt="{{ 'product_page.brushed_story_stack_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.brushed_story_stack_eyebrow' | t }}</p>
        <h2>{{ 'product_page.brushed_story_stack_title' | t }}</h2>
        <p>{{ 'product_page.brushed_story_stack_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'brushed-story-edge.webp' | asset_url }}"
          width="1268"
          height="1585"
          alt="{{ 'product_page.brushed_story_edge_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.brushed_story_edge_eyebrow' | t }}</p>
        <h2>{{ 'product_page.brushed_story_edge_title' | t }}</h2>
        <p>{{ 'product_page.brushed_story_edge_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'brushed-story-lean.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.brushed_story_lean_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.brushed_story_lean_eyebrow' | t }}</p>
        <h2>{{ 'product_page.brushed_story_lean_title' | t }}</h2>
        <p>{{ 'product_page.brushed_story_lean_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'brushed-story-room.webp' | asset_url }}"
          width="800"
          height="1000"
          alt="{{ 'product_page.brushed_story_room_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.brushed_story_room_eyebrow' | t }}</p>
        <h2>{{ 'product_page.brushed_story_room_title' | t }}</h2>
        <p>{{ 'product_page.brushed_story_room_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'brushed-story-hanging.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.brushed_story_hanging_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.brushed_story_hanging_eyebrow' | t }}</p>
        <h2>{{ 'product_page.brushed_story_hanging_title' | t }}</h2>
        <p>{{ 'product_page.brushed_story_hanging_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
