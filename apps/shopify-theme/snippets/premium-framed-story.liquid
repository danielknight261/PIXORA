{%- comment -%}
  Photobox-style stepped rows for premium semi-glossy wooden framed prints.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.premium_framed_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'premium-framed-story-look.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.premium_framed_story_look_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.premium_framed_story_look_eyebrow' | t }}</p>
        <h2>{{ 'product_page.premium_framed_story_look_title' | t }}</h2>
        <p>{{ 'product_page.premium_framed_story_look_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'premium-framed-story-colours.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.premium_framed_story_colours_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.premium_framed_story_colours_eyebrow' | t }}</p>
        <h2>{{ 'product_page.premium_framed_story_colours_title' | t }}</h2>
        <p>{{ 'product_page.premium_framed_story_colours_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'premium-framed-story-hanging.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.premium_framed_story_hanging_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.premium_framed_story_hanging_eyebrow' | t }}</p>
        <h2>{{ 'product_page.premium_framed_story_hanging_title' | t }}</h2>
        <p>{{ 'product_page.premium_framed_story_hanging_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'premium-framed-story-room.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.premium_framed_story_room_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.premium_framed_story_room_eyebrow' | t }}</p>
        <h2>{{ 'product_page.premium_framed_story_room_title' | t }}</h2>
        <p>{{ 'product_page.premium_framed_story_room_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
