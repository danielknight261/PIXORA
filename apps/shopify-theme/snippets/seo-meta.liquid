{%- comment -%}
  Titles, descriptions, social cards, robots, Organization/WebSite JSON-LD.
  Do not add custom hreflang — Shopify Markets injects it via content_for_header.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign seo_hidden = false
  case request.page_type
    when 'cart', 'search', '404', 'password', 'gift_card', 'captcha'
      assign seo_hidden = true
    when 'customers/login', 'customers/register', 'customers/account', 'customers/activate_account', 'customers/reset_password', 'customers/addresses', 'customers/order'
      assign seo_hidden = true
  endcase

  assign seo_title = page_title
  if request.page_type == 'index'
    if page_title == shop.name or page_title == brand or page_title == blank
      assign seo_title = 'seo.home_title' | t
    endif
  else
    if current_tags != blank
      assign tag_list = current_tags | join: ', '
      assign seo_title = seo_title | append: ' – tagged "' | append: tag_list | append: '"'
    endif
    if current_page != 1
      assign seo_title = seo_title | append: ' – Page ' | append: current_page
    endif
    unless page_title contains shop.name or page_title contains brand
      assign seo_title = seo_title | append: ' – ' | append: brand
    endunless
  endif

  assign meta_description = page_description | strip
  if meta_description == blank
    if request.page_type == 'index'
      assign meta_description = 'seo.home_description' | t
    elsif request.page_type == 'product'
      assign meta_description = product.description | strip_html | strip | truncate: 160
      if meta_description == blank
        assign meta_description = 'seo.product_description' | t: title: product.title
      endif
    elsif request.page_type == 'collection'
      assign meta_description = collection.description | strip_html | strip | truncate: 160
      if meta_description == blank
        assign meta_description = 'seo.collection_description' | t: title: collection.title
      endif
    else
      assign meta_description = 'seo.default_description' | t
    endif
  endif

  assign og_alt = 'seo.og_image_alt' | t
  if request.page_type == 'product' and product.featured_media
    assign og_image = product.featured_media | image_url: width: 1200 | prepend: 'https:'
    assign og_alt = product.featured_media.alt | default: product.title
  elsif request.page_type == 'collection' and collection.image
    assign og_image = collection.image | image_url: width: 1200 | prepend: 'https:'
    assign og_alt = collection.image.alt | default: collection.title
  elsif settings.logo != blank
    assign og_image = settings.logo | image_url: width: 1200 | prepend: 'https:'
  else
    assign og_image = 'snappdaddy-logo.png' | asset_url
    unless og_image contains 'http'
      assign og_image = og_image | prepend: 'https:'
    endunless
  endif

  if settings.logo != blank
    assign seo_logo = settings.logo | image_url: width: 600 | prepend: 'https:'
  else
    assign seo_logo = 'snappdaddy-logo.png' | asset_url
    unless seo_logo contains 'http'
      assign seo_logo = seo_logo | prepend: 'https:'
    endunless
  endif

  assign og_locale = request.locale.iso_code | replace: '-', '_'
-%}
<title>{{ seo_title | escape }}</title>
<meta name="description" content="{{ meta_description | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
{% if seo_hidden %}
  <meta name="robots" content="noindex, nofollow">
{% endif %}
<meta name="theme-color" content="{{ settings.color_primary | default: '#25483B' }}">

<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{{ meta_description | escape }}">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:alt" content="{{ og_alt | escape }}">
{% if request.page_type == 'product' %}
  <meta property="og:type" content="product">
  <meta property="og:image:width" content="1200">
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | escape }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{% else %}
  <meta property="og:type" content="website">
{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ meta_description | escape }}">
<meta name="twitter:image" content="{{ og_image }}">
<meta name="twitter:image:alt" content="{{ og_alt | escape }}">

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ shop.url | append: '#organization' | json }},
    "name": {{ brand | json }},
    "url": {{ shop.url | json }},
    "logo": {{ seo_logo | json }},
    "description": {{ 'seo.default_description' | t | json }},
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "url": {{ shop.url | append: '/pages/contact' | json }}
    }
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ brand | json }},
    "url": {{ shop.url | json }},
    "description": {{ 'seo.home_description' | t | json }},
    "publisher": { "@id": {{ shop.url | append: '#organization' | json }} }
  }
</script>
