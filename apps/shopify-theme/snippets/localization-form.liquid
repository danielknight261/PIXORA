{%- comment -%}
  Country and language selector. Appears once Shopify Markets / languages are enabled.
{%- endcomment -%}
{%- assign unique = unique | default: 'store' -%}
{%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
  {%- form 'localization', class: 'localization' -%}
    {%- if localization.available_countries.size > 1 -%}
      <div class="localization__field">
        <label class="visually-hidden" for="LocalizationCountry-{{ unique }}">{{ 'localization.country' | t }}</label>
        <select
          name="country_code"
          id="LocalizationCountry-{{ unique }}"
          class="localization__select"
          data-localization-select
        >
          {%- for country in localization.available_countries -%}
            <option
              value="{{ country.iso_code }}"
              {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
            >
              {{ country.iso_code }} ({{ country.currency.iso_code }})
            </option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
    {%- if localization.available_languages.size > 1 -%}
      <div class="localization__field">
        <label class="visually-hidden" for="LocalizationLanguage-{{ unique }}">{{ 'localization.language' | t }}</label>
        <select
          name="locale_code"
          id="LocalizationLanguage-{{ unique }}"
          class="localization__select"
          data-localization-select
        >
          {%- for language in localization.available_languages -%}
            <option
              value="{{ language.iso_code }}"
              {% if language.iso_code == localization.language.iso_code %}selected{% endif %}
            >
              {{ language.endonym_name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
    <noscript>
      <button type="submit" class="button">{{ 'localization.update' | t }}</button>
    </noscript>
  {%- endform -%}
{%- endif -%}
