{%- comment -%}
  Photobox-style stepped rows for smooth aluminum prints.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.aluminum_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'aluminum-story-panel.webp' | asset_url }}"
          width="1268"
          height="1585"
          alt="{{ 'product_page.aluminum_story_panel_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.aluminum_story_panel_eyebrow' | t }}</p>
        <h2>{{ 'product_page.aluminum_story_panel_title' | t }}</h2>
        <p>{{ 'product_page.aluminum_story_panel_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'aluminum-story-edge.webp' | asset_url }}"
          width="1268"
          height="1585"
          alt="{{ 'product_page.aluminum_story_edge_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.aluminum_story_edge_eyebrow' | t }}</p>
        <h2>{{ 'product_page.aluminum_story_edge_title' | t }}</h2>
        <p>{{ 'product_page.aluminum_story_edge_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'aluminum-story-lifestyle.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.aluminum_story_lifestyle_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.aluminum_story_lifestyle_eyebrow' | t }}</p>
        <h2>{{ 'product_page.aluminum_story_lifestyle_title' | t }}</h2>
        <p>{{ 'product_page.aluminum_story_lifestyle_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'aluminum-story-hanging.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.aluminum_story_hanging_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.aluminum_story_hanging_eyebrow' | t }}</p>
        <h2>{{ 'product_page.aluminum_story_hanging_title' | t }}</h2>
        <p>{{ 'product_page.aluminum_story_hanging_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
