{%- comment -%}
  Photobox-style stepped rows for birch plywood wood prints.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.wood_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'wood-story-panel.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.wood_story_panel_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.wood_story_panel_eyebrow' | t }}</p>
        <h2>{{ 'product_page.wood_story_panel_title' | t }}</h2>
        <p>{{ 'product_page.wood_story_panel_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'wood-story-layers.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.wood_story_layers_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.wood_story_layers_eyebrow' | t }}</p>
        <h2>{{ 'product_page.wood_story_layers_title' | t }}</h2>
        <p>{{ 'product_page.wood_story_layers_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'wood-story-corner.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.wood_story_corner_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.wood_story_corner_eyebrow' | t }}</p>
        <h2>{{ 'product_page.wood_story_corner_title' | t }}</h2>
        <p>{{ 'product_page.wood_story_corner_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'wood-story-pair.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.wood_story_pair_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.wood_story_pair_eyebrow' | t }}</p>
        <h2>{{ 'product_page.wood_story_pair_title' | t }}</h2>
        <p>{{ 'product_page.wood_story_pair_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'wood-story-room.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.wood_story_room_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.wood_story_room_eyebrow' | t }}</p>
        <h2>{{ 'product_page.wood_story_room_title' | t }}</h2>
        <p>{{ 'product_page.wood_story_room_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
