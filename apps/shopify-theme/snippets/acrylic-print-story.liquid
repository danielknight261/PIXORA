{%- comment -%}
  Photobox-style stepped rows for acrylic prints with standoff mounts.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.acrylic_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'acrylic-story-look.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.acrylic_story_look_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.acrylic_story_look_eyebrow' | t }}</p>
        <h2>{{ 'product_page.acrylic_story_look_title' | t }}</h2>
        <p>{{ 'product_page.acrylic_story_look_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'acrylic-story-edge.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.acrylic_story_edge_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.acrylic_story_edge_eyebrow' | t }}</p>
        <h2>{{ 'product_page.acrylic_story_edge_title' | t }}</h2>
        <p>{{ 'product_page.acrylic_story_edge_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'acrylic-story-stack.webp' | asset_url }}"
          width="1000"
          height="1000"
          alt="{{ 'product_page.acrylic_story_stack_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.acrylic_story_stack_eyebrow' | t }}</p>
        <h2>{{ 'product_page.acrylic_story_stack_title' | t }}</h2>
        <p>{{ 'product_page.acrylic_story_stack_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'acrylic-story-corner.webp' | asset_url }}"
          width="1000"
          height="1000"
          alt="{{ 'product_page.acrylic_story_corner_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.acrylic_story_corner_eyebrow' | t }}</p>
        <h2>{{ 'product_page.acrylic_story_corner_title' | t }}</h2>
        <p>{{ 'product_page.acrylic_story_corner_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'acrylic-story-hanging.webp' | asset_url }}"
          width="1000"
          height="1000"
          alt="{{ 'product_page.acrylic_story_hanging_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.acrylic_story_hanging_eyebrow' | t }}</p>
        <h2>{{ 'product_page.acrylic_story_hanging_title' | t }}</h2>
        <p>{{ 'product_page.acrylic_story_hanging_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
