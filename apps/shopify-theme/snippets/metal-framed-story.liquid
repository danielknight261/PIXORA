{%- comment -%}
  Photobox-style stepped rows for classic semi-glossy metal framed posters.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.metal_framed_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'metal-framed-story-look.webp' | asset_url }}"
          width="1681"
          height="2100"
          alt="{{ 'product_page.metal_framed_story_look_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.metal_framed_story_look_eyebrow' | t }}</p>
        <h2>{{ 'product_page.metal_framed_story_look_title' | t }}</h2>
        <p>{{ 'product_page.metal_framed_story_look_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'metal-framed-story-edge.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.metal_framed_story_edge_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.metal_framed_story_edge_eyebrow' | t }}</p>
        <h2>{{ 'product_page.metal_framed_story_edge_title' | t }}</h2>
        <p>{{ 'product_page.metal_framed_story_edge_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'metal-framed-story-hanging.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.metal_framed_story_hanging_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.metal_framed_story_hanging_eyebrow' | t }}</p>
        <h2>{{ 'product_page.metal_framed_story_hanging_title' | t }}</h2>
        <p>{{ 'product_page.metal_framed_story_hanging_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'metal-framed-story-wall.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.metal_framed_story_wall_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.metal_framed_story_wall_eyebrow' | t }}</p>
        <h2>{{ 'product_page.metal_framed_story_wall_title' | t }}</h2>
        <p>{{ 'product_page.metal_framed_story_wall_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
