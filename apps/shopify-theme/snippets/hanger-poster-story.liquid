{%- comment -%}
  Photobox-style stepped rows for premium matte posters with wooden hangers.
{%- endcomment -%}
<section class="pdp-story" aria-label="{{ 'product_page.hanger_story_label' | t }}">
  <div class="page-width">
    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'hanger-story-product.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.hanger_story_product_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.hanger_story_product_eyebrow' | t }}</p>
        <h2>{{ 'product_page.hanger_story_product_title' | t }}</h2>
        <p>{{ 'product_page.hanger_story_product_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'hanger-story-wood.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.hanger_story_wood_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.hanger_story_wood_eyebrow' | t }}</p>
        <h2>{{ 'product_page.hanger_story_wood_title' | t }}</h2>
        <p>{{ 'product_page.hanger_story_wood_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'hanger-story-paper.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.hanger_story_paper_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.hanger_story_paper_eyebrow' | t }}</p>
        <h2>{{ 'product_page.hanger_story_paper_title' | t }}</h2>
        <p>{{ 'product_page.hanger_story_paper_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row pdp-story__row--flip">
      <div class="pdp-story__media">
        <img
          src="{{ 'hanger-story-lifestyle.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.hanger_story_lifestyle_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.hanger_story_lifestyle_eyebrow' | t }}</p>
        <h2>{{ 'product_page.hanger_story_lifestyle_title' | t }}</h2>
        <p>{{ 'product_page.hanger_story_lifestyle_body' | t }}</p>
      </div>
    </article>

    <article class="pdp-story__row">
      <div class="pdp-story__media">
        <img
          src="{{ 'hanger-story-pair.webp' | asset_url }}"
          width="1680"
          height="2100"
          alt="{{ 'product_page.hanger_story_pair_alt' | t }}"
          loading="lazy"
        >
      </div>
      <div class="pdp-story__copy">
        <p class="pdp-story__eyebrow">{{ 'product_page.hanger_story_pair_eyebrow' | t }}</p>
        <h2>{{ 'product_page.hanger_story_pair_title' | t }}</h2>
        <p>{{ 'product_page.hanger_story_pair_body' | t }}</p>
      </div>
    </article>
  </div>
</section>
