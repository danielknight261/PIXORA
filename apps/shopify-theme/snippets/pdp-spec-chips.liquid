    {%- case kind -%}
      {%- when 'framed-canvas' -%}
        <li><span class="pdp-specs__label">{{ 'product_page.spec_frame' | t }}</span><span class="pdp-specs__value">{{ 'product_page.spec_tray_3' | t }}</span></li>
        <li><span class="pdp-specs__label">{{ 'product_page.spec_wrap' | t }}</span><span class="pdp-specs__value">{{ 'product_page.spec_canvas_wrap' | t }}</span></li>
