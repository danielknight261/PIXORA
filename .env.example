# Pixora Environment Variables Reference
# Production storefront is Shopify + Gelato (see docs/shopify-gelato-migration.md)

# --- Web App redirect (apps/web/.env.local) ---
NEXT_PUBLIC_SHOPIFY_STORE_URL=https://YOUR-STORE.myshopify.com

# --- Admin App (apps/admin/.env.local) — optional / legacy ---
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# GELATO_API_KEY no longer used for Pixora catalog sync (use Gelato Shopify app)

# --- Mobile App (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- API Package (packages/api/.env) — legacy ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Providers Package (packages/providers/.env) — legacy ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
PRODIGI_API_KEY=
GELATO_API_KEY=
